import 'module:spotube_plugin' as spotube
import { CorePlugin } from './core.ht'

class AuthEndpoint {
  var client: HttpClient
  final controller: StreamController

  get authStateStream -> Stream => controller.stream

  construct (this.client){
    controller = StreamController.broadcast()
  }

  fun isAuthenticated() -> bool {
    // Monochrome is essentially public without strict authentication.
    // So we can assume it's true, or return true when a custom url is configured.
    return true
  }

  fun authenticate() -> Future {
    return spotube.SpotubeForm.show(
      "Monochrome Settings",
      [
        {
          objectType: "text",
          text: "Configure your custom Monochrome instance URL or leave blank to use the public mirror list.",
        }.toJson(),
        {
          objectType: "input",
          id: "customInstance",
          variant: "text",
          placeholder: "https://your-custom-instance.com",
          required: false,
        }.toJson()
      ]
    ).then((result) {
      if (result != null && result.length > 0) {
        var customUrl = ""
        for (var item in result) {
            if (item["id"] == "customInstance") {
                customUrl = item["value"]
            }
        }
        
        if (customUrl != "") {
            return spotube.LocalStorage.setString("custom_instance", customUrl).then((_) {
                // Update active instances list in CorePlugin if needed
                CorePlugin.ActiveInstance = customUrl
                controller.add({ type: "login" }.toJson())
            })
        }
      }
      controller.add({ type: "login" }.toJson())
    })
  }

  fun logout() -> Future {
    return spotube.LocalStorage.remove("custom_instance").then((_) {
        CorePlugin.ActiveInstance = ""
        controller.add({ type: "logout" }.toJson())
    })
  }
}
